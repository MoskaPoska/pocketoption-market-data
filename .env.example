# Source WebSocket (Engine.IO v4)
SOURCE_WS_URL=wss://chat-po.site/cabinet-client/socket.io/?EIO=4&transport=websocket
SOURCE_ORIGIN=https://pocketoption.com

# Path to Playwright storage_state.json (cookies)
STORAGE_STATE_PATH=storage_state.json

# Redis
REDIS_URL=redis://redis:6379/0

# Reconnect / Heartbeat
RECONNECT_BASE_DELAY=1.0    # seconds, base for exponential backoff
RECONNECT_MAX_DELAY=30.0    # seconds, maximum backoff cap
RECONNECT_MAX_JITTER=1.0    # seconds, random jitter added to delay
PING_INTERVAL=20.0          # seconds, Engine.IO heartbeat interval

# App
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Socket.IO auth (from browser DevTools → Network → WS → Messages)
SOCKET_USER_ID=0
SOCKET_SECRET=

# Telegram Admin Alerts (cookie expiry warnings)
# Get bot token from @BotFather, admin IDs from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=[123456789]   # comma-separated list: [111,222,333]
COOKIE_WARN_DAYS=7
